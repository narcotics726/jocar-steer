# ── Gleam toolchain ──────────────────────────────────────
#use flake ~/workspace/my-devshell-flakes#gleam
# ── ESP32 toolchain ─────────────────────────────────────
# Xtensa GNU toolchain: provides `xtensa-esp32s3-elf-gcc`, the target's default
# linker (gnu-cc flavor). Required for linking; nothing else finds it on PATH.
export PATH="$HOME/.rustup/toolchains/esp/xtensa-esp-elf/esp-15.2.0_20250920/xtensa-esp-elf/bin:$PATH"
# LIBCLANG_PATH removed: only bindgen consumers (esp-idf-sys/clang-sys) read it,
# and this bare-metal no_std project has none. Re-add if you add such a dep.

# # ESP-IDF glob: copy partitions.csv to CMake build output (esp-idf-sys sets
# # PROJECT_DIR to its own out/ directory, not the project root, so CMake can't
# # find the custom partition CSV at the project root without this copy).
# export ESP_IDF_GLOB_PARTITIONS_BASE="$(pwd)"
# export ESP_IDF_GLOB_PARTITIONS_CSV="partitions.csv"

# Build-time config (gitignored, see .env.example)
[ -f .env ] && set -a && source .env && set +a